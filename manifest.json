{
  "schemaVersion": 1,
  "id": "vinicios.system-monitor",
  "name": "System Monitor (vinicios)",
  "version": "1.3.0",
  "author": "Harshith, vinicios",
  "license": "MIT",
  "homepage": "https://github.com/viniciosrab/omarchy-system-monitor",
  "description": "A low-overhead system dashboard for the Omarchy bar.",
  "kinds": ["bar-widget"],
  "activation": "on-demand",
  "entryPoints": {
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "System Monitor",
    "description": "CPU, memory, GPU, temperature, network, and disk activity.",
    "category": "System",
    "aliases": ["sysmon", "system-stats"],
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "barMode": "Adaptive",
      "closedRefreshSec": 5,
      "openRefreshSec": 2,
      "warningPercent": 80,
      "criticalPercent": 95,
      "networkInterface": ""
    },
    "schema": [
      { "key": "barMode", "type": "enum", "label": "Bar display", "options": ["Adaptive", "CPU", "Memory", "GPU", "Both", "Icon"], "defaultValue": "Adaptive" },
      { "key": "closedRefreshSec", "type": "integer", "label": "Closed refresh interval (seconds)", "min": 1, "max": 60, "step": 1, "defaultValue": 5 },
      { "key": "openRefreshSec", "type": "integer", "label": "Open refresh interval (seconds)", "min": 1, "max": 10, "step": 1, "defaultValue": 2 },
      { "key": "warningPercent", "type": "integer", "label": "Warning threshold", "min": 50, "max": 95, "step": 1, "defaultValue": 80 },
      { "key": "criticalPercent", "type": "integer", "label": "Critical threshold", "min": 60, "max": 100, "step": 1, "defaultValue": 95 },
      { "key": "networkInterface", "type": "string", "label": "Network interface", "defaultValue": "", "description": "Leave empty to follow the default route." }
    ]
  }
}
